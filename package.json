{
  "name": "melodio",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "start-server-and-test dev http://127.0.0.1:5173 \"cypress run\"",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier -w .",
    "android:add": "npx cap add android",
    "android:build": "npm run build && npx cap copy",
    "android:dev": "npm run android:build && npx cap open android",
    "android:open": "npx cap open android",
    "cap": "npx cap sync",
    "check": "npx eslint src/"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "8.3.4",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.3",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/iconify": "^3.1.1",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@odion-cloud/capacitor-mediastore": "^1.0.21",
    "cordova-plugin-file": "^8.1.3",
    "ionicons": "^7.0.0",
    "pinia": "^3.0.4",
    "pinyin-match": "^1.2.10",
    "prettier": "^3.8.3",
    "vue": "^3.3.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@iconify/vue": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.6",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "sass-embedded": "^1.100.0",
    "start-server-and-test": "^3.0.13",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10"
  },
  "description": "A smooth, offline-first music player built with Ionic Vue and Capacitor."
}
